 */

export interface Endpoints {
  "GET /items": {
    params: void
    query: { q: string }
    body: void
    response: Schemas.Item[]
  }
  "GET /items/{itemId}": {
    params: { itemId: string }
    query: void
    body: void
    response: Schemas.Item
  }
  "GET /health": {
    params: void
    query: void
    body: void
    response: void
  }
}

export interface Webhooks {
  /**
   * @summary Fired when a new item is created
   * @deprecated
   */
  "POST item.created": {
    query: void
    payload: Schemas.Item
    reply: boolean
  }
}

export namespace Schemas {
  export type ItemKind = "book" | "movie" | "music"

  export type Shape = Circle | Square

  export type Extended = Circle & {
    color: string
  }

  export interface Item {
    id: number
    name: string
    tags?: string[]
    metadata?: Record<string, string>
    kind?: ItemKind
  }

  export interface Circle {
    radius: number
  }

  export interface Square {
    side: number
  }
}
"
`;

