exports[`generate (integration) > formats maps date-time to Date in petstore 1`] = `
"/**
 * Petstore
 *
 * @version 1.0.0
 * @generated by openapi-shape.
 */

export interface Endpoints {
  /**
   * @summary List pets
   * @description Returns all pets, optionally limited.
   */
  "GET /pets": {
    params: void
    query: {
      /** @description Max number of results */
      limit?: number
    }
    body: void
    response: Schemas.Pet[]
  }
  /** @summary Create a pet */
  "POST /pets": {
    params: void
    query: void
    body?: Schemas.CreatePet
    response: Schemas.Pet
  }
  "GET /pets/{petId}": {
    params: { petId: string }
    query: void
    body: void
    response: Schemas.Pet
  }
  /** @deprecated */
  "DELETE /pets/{petId}": {
    params: { petId: string }
    query: void
    body: void
    response: void
  }
}

export namespace Schemas {
  /** @description Lifecycle status of a pet */
  export type PetStatus = "available" | "pending" | "sold"

  /** @description A pet in the store */
  export interface Pet {
    /** @description Unique identifier */
    id: number
    /** @description Display name */
    name: string
    tag?: string
    status?: PetStatus
  }

  export interface CreatePet {
    name: string
    tag?: string
  }
}
"
`;

