{
  "$schema": "node_modules/lefthook/schema.json",
  "commit-msg": {
    "commands": {
      "commitlint": {
        "run": "pnpm exec commitlint --edit {1}"
      }
    }
  },
  "pre-commit": {
    "parallel": true,
    "commands": {
      "format": {
        "glob": "*.{ts,tsx,js,mjs,cjs,jsx}",
        "run": "pnpm exec oxfmt {staged_files} --no-error-on-unmatched-pattern",
        "stage_fixed": true
      },
      "lint": {
        "glob": "*.{ts,tsx,js,mjs,cjs,jsx}",
        "run": "pnpm exec oxlint {staged_files}"
      },
      "typecheck": {
        "glob": "*.{ts,tsx}",
        "run": "pnpm exec tsc --noEmit"
      }
    }
  }
}
