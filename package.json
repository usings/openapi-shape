{
  "name": "openapi-shape",
  "version": "0.9.0",
  "description": "Generate TypeScript API contract types from OpenAPI 3.0/3.1 JSON or YAML",
  "keywords": [
    "api-client",
    "codegen",
    "dts",
    "openapi",
    "openapi-typescript",
    "openapi3",
    "schema-to-typescript",
    "typed-api-client",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usings/openapi-shape.git"
  },
  "bin": {
    "openapi-shape": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./client": "./dist/client.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.0"
}
