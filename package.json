{
  "name": "openapi-shape",
  "version": "0.21.0",
  "description": "A lightweight, Web standards-based OpenAPI toolkit for TypeScript contracts, type-safe Fetch, and native streaming.",
  "keywords": [
    "api-client",
    "codegen",
    "fetch",
    "json-schema",
    "openapi",
    "openapi-typescript",
    "openapi3",
    "openapi31",
    "openapi32",
    "typed-api-client",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usings/openapi-shape.git"
  },
  "bin": {
    "openapi-shape": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "build": "tsdown",
    "test": "vitest",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=browser",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test --run && pnpm typecheck && pnpm lint && pnpm format --check"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "bumpp": "^12.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.8"
}
