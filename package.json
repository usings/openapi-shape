{
  "name": "openapi-shape",
  "version": "0.8.0",
  "description": "Generate TypeScript API contract types from OpenAPI 3.x JSON",
  "keywords": [
    "api-client",
    "codegen",
    "dts",
    "openapi",
    "openapi-typescript",
    "openapi3",
    "schema-to-typescript",
    "typed-api-client",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usings/openapi-shape.git"
  },
  "bin": {
    "openapi-shape": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./client": "./dist/client.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^25.6.0",
    "bumpp": "^11.1.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8"
}
